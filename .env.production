# Production Environment Variables for Frontend
# Copy this file to .env.production before build

# Backend API URL (PRODUCTION)
REACT_APP_API_URL=https://backend.pesantrenalihsanbekasi.or.id/api
REACT_APP_SERVER_URL=https://backend.pesantrenalihsanbekasi.or.id

# Google OAuth Client ID (if using Google Login)
REACT_APP_GOOGLE_CLIENT_ID=your_actual_google_client_id_here

# Environment
NODE_ENV=production

# Build optimization
GENERATE_SOURCEMAP=false
